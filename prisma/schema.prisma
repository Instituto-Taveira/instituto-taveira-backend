datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String    @id @unique
  name       String
  login      String    @unique
  password   String
  isAdm      Boolean
  isBlocked  Boolean   @default(false)
  firstLogin Boolean   @default(false)
  createdAt  DateTime  @default(now())
  role       Role?     @relation(fields: [roleId], references: [id])
  roleId     String?
  updatedAt  DateTime?
  Client     Client[]
}

model Role {
  id        String    @id @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  User      User[]
}

model Client {
  id            String     @id @unique
  name          String
  fone          String
  attendant     String?
  attendantId   String?
  attendantUser User?      @relation(fields: [attendantId], references: [id])
  observation   String?
  approved      Boolean    @default(true)
  address       Address?
  loan          Loan[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime?
  deletedAt     DateTime?
  Schedule      Schedule[]
}

model Address {
  id        String    @id @unique
  street    String
  district  String
  number    String
  city      String
  client    Client?   @relation(fields: [clientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clientId  String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Loan {
  id                  String    @id @unique
  payment_settled     Boolean   @default(false)
  value_loan          Float
  interest_rate       Float
  rest_loan           Float
  format_instalment   Int
  client              Client    @relation(fields: [clientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clientId            String
  startDate           DateTime
  dueDate             DateTime
  approved            Boolean   @default(true)
  only_pay_interest   Boolean   @default(false)
  value_interest_paid Float     @default(0)
  payment             Payment[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime?
  Schedule            Schedule? @relation(fields: [scheduleId], references: [id])
  scheduleId          String?
}

model Payment {
  id           String        @id @unique
  value        Float
  valuePaid    Float
  settled      Boolean       @default(false)
  loan         Loan          @relation(fields: [loanId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  loanId       String
  dueDate      DateTime
  iterestDelay IterestDelay?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?
}

model IterestDelay {
  id        String    @id @unique
  value     Float
  payDay    DateTime
  settled   Boolean   @default(false)
  paymentId String    @unique
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Schedule {
  id                String    @id @unique
  client            Client    @relation(fields: [clientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clientId          String
  date              DateTime
  value             Float
  interest_rate     Float
  format_instalment Int
  loan_to_settle    Loan[]
  value_sent        Float     @default(0)
  send              Boolean   @default(false)
  canceled          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime?
  paymentIds        String    @default("[]")
  loanIds           String    @default("[]")
}
