datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String    @id @unique
  name       String
  login      String    @unique
  password   String
  isAdm      Boolean
  isBlocked  Boolean   @default(false)
  firstLogin Boolean   @default(false)
  createdAt  DateTime  @default(now())
  role       Role?     @relation(fields: [roleId], references: [id])
  roleId     String?
  updatedAt  DateTime?
}

model Role {
  id        String    @id @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  User      User[]
}

model Pessoa {
  id             String   @id @default(uuid())
  nome           String
  dataNascimento DateTime
  cpf            String?  @unique
  rg             String?
  tituloEleitor  String?
  localVotacao   String?
  cartaoSUS      String?
  numeroContato  String?
  whatsapp       String?
  fotoBase64     String?

  dependenteDeId String?
  dependenteDe   Pessoa? @relation("DependenteRelation", fields: [dependenteDeId], references: [id])

  dependentes Pessoa[] @relation("DependenteRelation")

  endereco        String?
  rua             String
  numero          String
  bairro          String
  complemento     String?
  pontoReferencia String?
  cidade          String
  estado          String
  cep             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
