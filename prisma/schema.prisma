datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id         Int       @id @default(autoincrement())
  name       String
  login      String    @unique
  password   String
  isAdm      Boolean
  isBlocked  Boolean   @default(false)
  firstLogin Boolean   @default(false)
  createdAt  DateTime  @default(now())
  role       Role?     @relation(fields: [roleId], references: [id])
  roleId     Int?
  updatedAt  DateTime?

  @@map("users")
}

model Titular {
  id                Int                 @id @default(autoincrement())
  nome              String
  dataNascimento    DateTime
  cpf               String?             @unique
  rg                String?
  tituloEleitor     String?
  zona              String?
  secao             String?
  localVotacao      String?
  cartaoSUS         String?
  numeroContato     String?
  whatsapp          String?
  fotoBase64        String?
  endereco          Endereco?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Dependente        Dependente[]
  VinculoModalidade VinculoModalidade[]
  roleId            Int?

  @@map("titulares")
}

model Dependente {
  id                Int                 @id @default(autoincrement())
  nome              String
  dataNascimento    DateTime
  tipo              String              @default("")
  cpf               String?
  rg                String?
  tituloEleitor     String?
  zona              String?
  secao             String?
  localVotacao      String?
  cartaoSUS         String?
  numeroContato     String?
  whatsapp          String?
  fotoBase64        String?
  titularId         Int?
  titular           Titular?            @relation(fields: [titularId], references: [id], onDelete: Cascade)
  endereco          Endereco?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  VinculoModalidade VinculoModalidade[]

  @@map("dependentes")
}

model Endereco {
  id              Int         @id @default(autoincrement())
  cep             String
  rua             String
  numero          String
  bairro          String
  complemento     String?
  pontoReferencia String?
  cidade          String
  estado          String
  titularId       Int?        @unique
  titular         Titular?    @relation(fields: [titularId], references: [id], onDelete: Cascade)
  dependenteId    Int?        @unique
  dependente      Dependente? @relation(fields: [dependenteId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Modalidade {
  id                Int                 @id @default(autoincrement())
  nome              String              @unique
  descricao         String?
  ativo             Boolean             @default(true)
  vinculoModalidade VinculoModalidade[]

  @@map("modalidades")
}

model VinculoModalidade {
  id           Int         @id @default(autoincrement())
  modalidade   Modalidade? @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  modalidadeId Int?
  titular      Titular?    @relation(fields: [titularId], references: [id], onDelete: Cascade)
  titularId    Int?
  dependente   Dependente? @relation(fields: [dependenteId], references: [id], onDelete: Cascade)
  dependenteId Int?

  @@unique([modalidadeId, titularId])
  @@unique([modalidadeId, dependenteId])
  @@map("vinculo_modalidades")
}

model Role {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  Usuario   Usuario[]

  @@map("roles")
}

model Pagamento {
  id            Int        @id @default(autoincrement())
  status        Status     @default(ACTIVE)
  reference_id  String     @unique
  checkoutId    String     @unique
  createdAt     DateTime   @default(now())
  endedAt       DateTime?
  amount        Int?
  amountPayed   Int?
  paymentMethod String?
  willReceive   Int?
  payer         String?
  billing       Cobranca[]

  @@map("pagamentos")
}

model Cobranca {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  startDate   DateTime?
  endDate     DateTime?
  period      String
  billingDate DateTime?
  payment     Pagamento @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId   Int

  @@map("cobrancas")
}

enum Status {
  PAID
  ACTIVE
  DECLINED
  CANCELLED
  REFUNDED
}
