datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  login      String    @unique
  password   String
  isAdm      Boolean
  isBlocked  Boolean   @default(false)
  firstLogin Boolean   @default(false)
  createdAt  DateTime  @default(now())
  role       Role?     @relation(fields: [roleId], references: [id])
  roleId     Int?
  updatedAt  DateTime?
}

model Role {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  User      User[]
}

model Pessoa {
  id              Int      @id @default(autoincrement())
  nome            String
  dataNascimento  DateTime
  cpf             String?  @unique
  rg              String?
  tituloEleitor   String?
  zona            String?
  secao           String?
  localVotacao    String?
  cartaoSUS       String?
  numeroContato   String?
  whatsapp        String?
  fotoBase64      String?
  endereco        String?
  rua             String
  numero          String
  bairro          String
  complemento     String?
  pontoReferencia String?
  cidade          String
  estado          String
  cep             String

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Dependente Dependente[]
}

model Dependente {
  id             Int      @id @default(autoincrement())
  nome           String
  dataNascimento DateTime
  tipo           String   @default("")
  cpf            String?
  rg             String?
  tituloEleitor  String?
  zona           String?
  secao          String?
  localVotacao   String?
  cartaoSUS      String?
  numeroContato  String?
  whatsapp       String?
  fotoBase64     String?
  cep            String?
  rua            String?
  numero         String?
  bairro         String?
  cidade         String?
  estado         String?
  pessoaId       Int
  pessoa         Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
